# AI Blog Writing Agent - Environment Variables Template
# Copy this file to .env and fill in your API keys. DO NOT commit .env to version control!

# Groq API Key (LLM Inference - Llama-3.3-70b-versatile)
GROQ_API_KEY=your_groq_api_key_here

# Tavily API Key (Web Research & Search Integration)
TAVILY_API_KEY=your_tavily_api_key_here

# Google Gemini API Key (Multimodal Image Generation & Vision)
GOOGLE_API_KEY=your_google_api_key_here

# LangSmith Observability & Tracing (Optional)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=blog_writing_agent
